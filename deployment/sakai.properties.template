# Runtime-only property values are generated by configure-sakai.sh on the VM.
# This template documents the intentional settings without storing passwords.
vendor@org.sakaiproject.db.api.SqlService=mysql
driverClassName@javax.sql.BaseDataSource=com.mysql.cj.jdbc.Driver
hibernate.dialect=org.hibernate.dialect.MySQL8Dialect
url@javax.sql.BaseDataSource=jdbc:mysql://<private-mysql-fqdn>:3306/sakai?useUnicode=true&characterEncoding=UTF-8&sslMode=VERIFY_IDENTITY
username@javax.sql.BaseDataSource=sakaidb
password@javax.sql.BaseDataSource=<not-committed>
defaultTransactionIsolationString@javax.sql.BaseDataSource=TRANSACTION_READ_COMMITTED

serverName=<public-fqdn>
serverUrl=https://<public-fqdn>
serverId=sakai-dev
ui.service=Sakai Development Sandbox
user.timezone=Asia/Karachi

# bodyPath and bodyVolumes intentionally remain unset. Sakai 25.2 then stores
# content BLOBs in MySQL, rather than depending on VM-local file storage.
# content.upload.max and content.upload.ceiling remain unset: 20 MB default.
